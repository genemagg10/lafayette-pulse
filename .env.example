# Supabase (required for /api/projects and Pulse Board data)
# After deploy, GET /api/health reports whether these are working.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Claude API (used by scraper + chat bot)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI (used for RAG embeddings)
OPENAI_API_KEY=sk-your-openai-key-here

# Map (Leaflet with OpenStreetMap is free, or use Mapbox)
NEXT_PUBLIC_MAPBOX_TOKEN=optional-if-using-mapbox

# Geocoding
GOOGLE_MAPS_API_KEY=optional-for-geocoding
